# Configure these as PRIVATE environment variables on the API host.
# NEVER put client secrets, bot tokens, or user tokens in GitHub Pages files.
PORT=3000
DISCORD_CLIENT_ID=1388987529537126500
DISCORD_CLIENT_SECRET=SET_IN_HOST_SECRET_MANAGER
DISCORD_REDIRECT_URI=https://YOUR-API-HOST.example/api/auth/callback
DESTINY_DASHBOARD_URL=https://qvxy-lab.github.io/DestinyDashboard/
# For accurate installed/not-installed server lists:
DISCORD_BOT_TOKEN=SET_IN_HOST_SECRET_MANAGER
